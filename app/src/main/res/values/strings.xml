<resources>
    <string name="app_name">Yami</string>

    <string name="a11y_description">Lets Yami notice when you swipe to a new reel in Instagram so it can count them. Yami does not read or store messages or content.</string>

    <string-array name="msg_concerned">
        <item>Sirf %d reels baaki. I\'m watching 👀</item>
        <item>%d left on your quota, citizen.</item>
        <item>Careful… %d more and it\'s a challan.</item>
    </string-array>

    <string-array name="msg_limit_hit">
        <item>STOP! Daily limit reached 🚨</item>
        <item>Bas! That\'s your quota for today.</item>
        <item>Phone neeche karo. Limit poori.</item>
    </string-array>

    <string-array name="msg_annoyed">
        <item>%d over. Phone neeche, please.</item>
        <item>Oye! %d reels over the limit.</item>
        <item>I\'m writing this down. +%d</item>
        <item>Move along, citizen. %d over.</item>
    </string-array>

    <string-array name="msg_angry">
        <item>%d OVER?! Hands where I can see them!</item>
        <item>Challan kat raha hai… +%d</item>
        <item>Bas karo yaar! %d over!</item>
        <item>Last warning. +%d</item>
    </string-array>

    <string-array name="msg_furious">
        <item>%d OVER!!! 🚨🚨</item>
        <item>FIR darj ho gayi. +%d</item>
        <item>Arrested for doomscrolling. +%d</item>
        <item>Main thak gaya hoon. %d over.</item>
    </string-array>

    <string-array name="break_messages_default">
        <item>Go touch grass 🌱</item>
        <item>Phone neeche. Hands up! 🚨</item>
        <item>Drink a glass of water 💧</item>
        <item>Call your ammi ☎️</item>
        <item>Look out of the window for one minute</item>
        <item>Stand up and stretch 🙆</item>
        <item>Challan kat gaya. Break time!</item>
    </string-array>

    <string-array name="msg_thrown">
        <item>Oye! Police se panga? 😤</item>
        <item>Throwing an officer? That\'s a challan.</item>
        <item>Main wardi mein hoon, bhai!</item>
        <item>Ouch. Writing this in my report.</item>
    </string-array>
    <string-array name="msg_shaken">
        <item>Chakkar aa gaye… 😵</item>
        <item>Bas karo, sab ghoom raha hai!</item>
        <item>Officer down! Officer down!</item>
    </string-array>

