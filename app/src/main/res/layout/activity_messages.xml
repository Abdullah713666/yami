<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/messages_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yami_bg"
    android:orientation="vertical">

    <!-- Top App Bar / Duty Ledger Header -->
    <LinearLayout
        android:id="@+id/messages_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/yami_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_sm"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_sm">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            style="@style/TextAppearance.Yami.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_xs"
            android:layout_weight="1"
            android:text="@string/messages_activity_title" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/yami_stroke" />

    <!-- Tab / Section Switcher -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/messages_tab_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_lg"
        android:layout_marginTop="@dimen/spacing_md"
        android:layout_marginEnd="@dimen/spacing_lg"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tab_break"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tab_break_messages"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tab_lines"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tab_custom_lines"
            android:textSize="13sp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Break Messages Section -->
    <LinearLayout
        android:id="@+id/break_section_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_md">

        <!-- Inline Preview Card: Shows tapped break message title on card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/break_preview_card"
            style="@style/Widget.Yami.LedgerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/yami_break_card"
            app:strokeColor="@color/yami_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    style="@style/TextAppearance.Yami.Stamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/yami_challan_red_container"
                    android:paddingStart="@dimen/spacing_xs"
                    android:paddingTop="@dimen/spacing_xxs"
                    android:paddingEnd="@dimen/spacing_xs"
                    android:paddingBottom="@dimen/spacing_xxs"
                    android:text="@string/preview_card_title"
                    android:textColor="@color/yami_challan_red" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.example.yami.character.ShahidView
                        android:id="@+id/preview_shahid"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="@dimen/spacing_md" />

                    <TextView
                        android:id="@+id/preview_title"
                        style="@style/TextAppearance.Yami.Title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/yami_break_ink"
                        tools:text="Go touch grass 🌱" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Add Break Message Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/add_break_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:layout_weight="1"
                android:hint="@string/add_break_hint"
                app:counterEnabled="true"
                app:counterMaxLength="80">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/add_break_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLength="80"
                    android:maxLines="2"
                    android:textColor="@color/yami_ink"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/add_break_button"
                style="@style/Widget.Yami.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:text="@string/add_button" />
        </LinearLayout>

        <!-- Messages List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_break_messages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/spacing_sm"
            android:layout_weight="1"
            android:clipToPadding="false"
            tools:listitem="@layout/item_break_message" />

    </LinearLayout>

    <!-- Shahid's Custom Lines Section -->
    <LinearLayout
        android:id="@+id/lines_section_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_md"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Explanatory Helper Banner -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Yami.LedgerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/yami_surface_subtle">

            <TextView
                style="@style/TextAppearance.Yami.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_md"
                android:text="@string/custom_lines_helper"
                android:textColor="@color/yami_text_secondary"
                android:textSize="13sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Preset Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/presets_chip_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_preset_1"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chip_preset_1"
                    android:textSize="12sp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_preset_2"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chip_preset_2"
                    android:textSize="12sp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_preset_3"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chip_preset_3"
                    android:textSize="12sp" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Add Custom Line Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/add_line_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:layout_weight="1"
                android:hint="@string/add_line_hint"
                app:counterEnabled="true"
                app:counterMaxLength="80">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/add_line_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLength="80"
                    android:maxLines="2"
                    android:textColor="@color/yami_ink"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/add_line_button"
                style="@style/Widget.Yami.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:text="@string/add_button" />
        </LinearLayout>

        <!-- Custom Lines List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_custom_lines"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/spacing_sm"
            android:layout_weight="1"
            android:clipToPadding="false"
            tools:listitem="@layout/item_custom_line" />

    </LinearLayout>

</LinearLayout>
